using UnityEngine.InputSystem;
using UnityEngine.XR.Interaction.Toolkit;
using Unity.XR.CoreUtils;

public class XRMovement : MonoBehaviour
{
    private ThePauseMenu menu;
    private XROrigin XROrigin;

    public ActionBasedContinuousMoveProvider CMP;
    public float jumpSpeed = 5f;
    public Transform groundCheck;
    public LayerMask groundLayer;
    public LayerMask Environment;
    public float sprintDuration = 3f;
    public float sprintCooldown = 5f;
    public float sprintMultiplier = 1.5f;
    private float sprintTimer;
    private float activeSprintCooldown;
    private bool isSprinting = false;
    private float crouchMultiplier = 2f;
    private float crouchSpeedMultiplier = 2f;
    public float crouchHeight = 4f;
    //public float normalHeight = 10f;
    private bool isCrouching;
    public Transform playerCamera;  // Reference to the camera transform
    
    private CharacterController controller;
    private Vector3 velocity;
    private PlayerInput playerInput;
    private InputAction sprintAction;
    private InputAction jumpAction;
    private InputAction crouchAction;
    private InputAction pauseAction;
    private bool isGrounded;
    private bool canCrouch = true;

    private bool canPause = true;  // Flag to control pause state
    private float pauseCooldown = 0.2f;  // Cooldown duration
    private float pauseTimer = 0f;  // Timer for cooldown
    //private bool isPauseCoroutineRunning = false;
    private bool isPauseButtonPressed = false;
    private CapsuleCollider playerCollider;

    private float center;
    private float cam;
    private float height;
    private float radius; 
    private Transform XRTransform;
    private float Ypos;
    private float cameraOffset;


    // Initialize components and input actions
    void Awake()
    {
        menu = FindObjectOfType<ThePauseMenu>();
        XROrigin = GetComponent<XROrigin>();
        controller = GetComponent<CharacterController>();
        playerInput = GetComponent<PlayerInput>();
        sprintAction = playerInput.actions["Sprint"];
        jumpAction = playerInput.actions["Jump"];
        crouchAction = playerInput.actions["Crouch"];
        pauseAction = playerInput.actions["Pause"]; 
        isCrouching = false;
        XRTransform = GetComponent<Transform>();

        //playerCollider = playerTransform.GetComponent<CapsuleCollider>();
        //cam = cameraOffset.localPosition.y;
        center = controller.center.y;
        height = controller.height;
        radius = controller.radius;
        Ypos = XRTransform.position.y;
        cameraOffset = XROrigin.CameraYOffset;
    }

    private void Update()
    {
        var sprintInput = sprintAction.ReadValue<float>();
        var jumpInput = jumpAction.ReadValue<float>();
        var crouchInput = crouchAction.ReadValue<float>();
        var pauseInput = pauseAction.ReadValue<float>();

        if (pauseInput > 0 && !isPauseButtonPressed)
        {
            isPauseButtonPressed = true;
            menu.TogglePause();
        }
        else if (pauseInput <= 0)
        {
            isPauseButtonPressed = false;
        }

        // Handle sprinting input and logic
        if (sprintInput > 0 && !isSprinting && activeSprintCooldown <= 0f)
        {
            StartSprinting();
        }

        // Handle sprinting logic when not sprinting
        if (!isSprinting)
        {
            SprintingLogic();
        }

        // Handle jumping input
        if (velocity.y <= 0 && jumpInput > 0)
        {
            Jump();
        }

        // Handle crouching input
        if (crouchInput > 0 && canCrouch)
        {
            if (!isCrouching)
            {
                Crouch();
            }
            else
            {
                Stand();
            }
        }

        // Apply gravity to the player
        ApplyGravity();

        // Update camera height based on crouching/standing state
        //UpdateCameraHeight();
    }


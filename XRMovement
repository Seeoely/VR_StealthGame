    // Start the sprinting process
    private void StartSprinting()
    {
        isSprinting = true;
        sprintTimer = sprintDuration;
        CMP.moveSpeed *= sprintMultiplier;
        activeSprintCooldown = sprintCooldown;
        StartCoroutine(SprintingCoroutine());
    }

    // Coroutine to manage sprint duration
    private IEnumerator SprintingCoroutine()
    {
        while (sprintTimer > 0f)
        {
            sprintTimer -= Time.deltaTime;
            yield return null;
        }

        StopSprinting();
    }

    // Stop the sprinting process
    private void StopSprinting()
    {
        isSprinting = false;
        CMP.moveSpeed /= sprintMultiplier;
    }

    // Manage sprint cooldown logic
    private void SprintingLogic()
    {
        if (activeSprintCooldown > 0f)
        {
            activeSprintCooldown -= Time.deltaTime;
        }
    }

    // Apply the jump force
    private void Jump()
    {
        velocity.y = Mathf.Sqrt(jumpSpeed * -2f * Physics.gravity.y);
    }

    // Apply gravity and manage vertical movement
    private void ApplyGravity()
    {
        if (!controller.isGrounded)
        {
            velocity.y += Physics.gravity.y * Time.deltaTime;
        }

        if (controller.isGrounded)
        {
            velocity.y = -2f; // Small value to keep the player grounded
        }

        // Move the character controller with the calculated velocity
        controller.Move(velocity * Time.deltaTime);
    }

    private void Crouch()
    {
        UnityEngine.Debug.Log("Crouch");
        isCrouching = true;
        CMP.moveSpeed /= crouchSpeedMultiplier;
        XRTransform.position = new Vector3(0, .5f, 0);
        XROrigin.CameraYOffset = .5f;
        //controller.center = new Vector3(controller.center.x, -1f, controller.center.z);
        //controller.height = .8f;
        controller.radius = .40f;

        // radius = .65  height = 1  center = -0.425  cam = 1.25
    }

    private void Stand()
    {
        UnityEngine.Debug.Log("Attempting to stand");

        // Define the position to start the raycast (from player's current head when crouching)
        Vector3 rayOrigin = XRTransform.position + Vector3.up * (controller.height / 2);

        // Define the max distance for the raycast (distance from crouched position to full standing height)
        float rayDistance = height - (controller.height / 2);

        // Perform the raycast upwards to check for obstacles
        if (!Physics.Raycast(rayOrigin, Vector3.up, rayDistance, Environment))
        {
            // No obstacles detected, the player can stand up
            isCrouching = false;
            CMP.moveSpeed *= crouchSpeedMultiplier;
            XRTransform.position = new Vector3(XRTransform.position.x, Ypos, XRTransform.position.z);
            XROrigin.CameraYOffset = 2.5f;  // Adjust as needed based on your camera system
            controller.height = height;  // Set controller height back to standing height
            controller.radius = radius;
            UnityEngine.Debug.Log("Standing up");
        }
        else
        {
            // Obstacle detected, player can't stand up
            UnityEngine.Debug.Log("Cannot stand up, obstacle detected above");
        }
    }
}
